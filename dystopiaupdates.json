  {
    "UpdateStageName": "Prepare SourceMod installer",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "CreateFile",
    "UpdateSourceData": "#!/bin/bash\nset -euo pipefail\ncd dystopia/17585\ntest -d amp-sm-stage/addons/sourcemod\ntest -d dystopia\nsrc=amp-sm-stage/addons/sourcemod\ndst=dystopia/addons/sourcemod\nmkdir -p \"$dst\" dystopia/cfg\n# Existing configuration and admin files are retained.\ncp -an amp-sm-stage/cfg/. dystopia/cfg/\nmkdir -p \"$dst/configs\"\ncp -an \"$src/configs/.\" \"$dst/configs/\"\nfor part in bin extensions gamedata translations scripting; do\n    if [ -d \"$src/$part\" ]; then\n        mkdir -p \"$dst/$part\"\n        cp -a \"$src/$part/.\" \"$dst/$part/\"\n    fi\ndone\nif [ ! -d \"$dst/plugins\" ]; then\n    cp -a \"$src/plugins\" \"$dst/\"\nelse\n    # Update installed stock plugins without re-enabling disabled plugins.\n    mkdir -p \"$dst/plugins/disabled\"\n    for plugin in \"$src/plugins/\"*.smx; do\n        [ -f \"$plugin\" ] || continue\n        name=$(basename \"$plugin\")\n        if [ -f \"$dst/plugins/$name\" ]; then\n            cp -a \"$plugin\" \"$dst/plugins/$name\"\n        else\n            cp -a \"$plugin\" \"$dst/plugins/disabled/$name\"\n        fi\n    done\nfi\ncp -a amp-sm-stage/addons/metamod/. dystopia/addons/metamod/\necho 'SourceMod installed. Existing configuration and plugin enable/disable choices preserved.'",
    "UpdateSourceArgs": "{{$FullBaseDir}}amp-install-sourcemod.sh",
    "UpdateSourceTarget": "",
    "UpdateSourceConditionSetting": "InstallMod",
    "UpdateSourceConditionValue": "true",
    "SkipOnFailure": false,
    "OverwriteExistingFiles": true
  },
